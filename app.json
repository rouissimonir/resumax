{
  "expo": {
    "name": "Resumax",
    "slug": "resumax",
    "version": "1.2.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resumeimprover",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "monirrouissi2.resumeimprover.app",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.resumeimprover.app",
      "versionCode": 34,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#09090B"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Resumax needs access to your photos so you can add a headshot to CV formats that use one.",
          "cameraPermission": "Resumax needs camera access so you can take a headshot for your CV."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e076346a-324b-46de-9ff1-817664808735"
      }
    },
    "owner": "monirrouissi2"
  }
}
